# ---------- 0) GITHUB (deploy.py uchun) ----------
# https://github.com/settings/tokens/new  -> scopes: repo + workflow
GITHUB_TOKEN=ghp_...

# ---------- 1) GOOGLE GEMINI (Agent 1 matn + Agent 2 Nano Banana rasm) ----------
# https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...

# ---------- RASM PROVAYDERI ----------
# pollinations = TEKIN, kalit kerak emas (sana modeli)  <- standart
# gemini       = Nano Banana 2, ancha sifatli, ~$0.067/rasm, billing kerak
IMAGE_PROVIDER=pollinations
POLLI_MODEL=sana
IMAGE_SIZE=2K

# Rasm sifatini oshirish (tekin rejim uchun muhim)
SHARPEN=0.9
GRAIN=3
VIGNETTE=false
ZOOM_AMP=0.10

# Rang va kayfiyat (quvnoq uslub)
SATURATION=1.18
BRIGHTNESS=0.02
CONTRAST=1.04

# Modellar (kerak bo'lsa o'zgartiring)
TEXT_MODEL=gemini-3.5-flash
# asosiy model band bo'lsa navbat bilan shular sinaladi
TEXT_MODEL_FALLBACKS=gemini-3.6-flash,gemini-2.5-flash,gemini-3.5-flash-lite,gemini-3-flash-preview
IMAGE_MODEL=gemini-3.1-flash-image
IMAGE_MODEL_FALLBACK=gemini-2.5-flash-image

# ---------- 2) TELEGRAM (Agent 3) ----------
# @BotFather -> /newbot -> token
TELEGRAM_BOT_TOKEN=123456:AA...
# Kanal/guruh ID yoki @username. Bot o'sha yerda admin bo'lishi shart.
TELEGRAM_CHAT_ID=@mening_kanalim

# ---------- 3) YOUTUBE (Agent 3, ixtiyoriy) ----------
# 1 marta: python youtube_auth.py  -> youtube_token.json yaratiladi
YOUTUBE_ENABLED=true
YOUTUBE_CLIENT_SECRET=client_secret.json
YOUTUBE_TOKEN_FILE=youtube_token.json
# public | unlisted | private
YOUTUBE_PRIVACY=public

# true  -> video Telegramga tugmalar bilan boradi, siz tasdiqlagach YouTube'ga chiqadi
# false -> darhol YouTube'ga yuklaydi
APPROVAL_MODE=true

# Promt tayyor bo'lgach botga yuborib qaror kutish.
# Bu soniyalar ichida "O'zim yasayman" bosilmasa — avtomat davom etadi.
HANDOFF=true
HANDOFF_WAIT=120

# ---------- 4) KONTENT ----------
NICHE=mind-blowing history and science facts
LANG=en
VOICE=en-US-AndrewMultilingualNeural
VOICE_FALLBACKS=en-US-BrianMultilingualNeural,en-US-GuyNeural,en-US-ChristopherNeural,en-GB-RyanNeural
SCENES=6
IMAGE_STYLE=bright cinematic photoreal, vivid saturated colours, clean daylight, crisp detail, playful
MUSIC_DIR=assets/music
MUSIC_VOLUME=0.10
