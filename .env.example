# ---------- 0) GITHUB (deploy.py uchun) ----------
# https://github.com/settings/tokens/new  -> scopes: repo + workflow
GITHUB_TOKEN=ghp_...

# ---------- 1) GOOGLE GEMINI (Agent 1 matn + Agent 2 Nano Banana rasm) ----------
# https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...

# ---------- RASM PROVAYDERI ----------
# pollinations = TEKIN, kalit kerak emas (FLUX)   <- standart
# gemini       = Nano Banana, sifatliroq, ~$0.03/rasm
IMAGE_PROVIDER=pollinations
POLLI_MODEL=flux

# Modellar (kerak bo'lsa o'zgartiring)
TEXT_MODEL=gemini-3-flash
IMAGE_MODEL=gemini-3.1-flash-image
IMAGE_MODEL_FALLBACK=gemini-2.5-flash-image

# ---------- 2) TELEGRAM (Agent 3) ----------
# @BotFather -> /newbot -> token
TELEGRAM_BOT_TOKEN=123456:AA...
# Kanal/guruh ID yoki @username. Bot o'sha yerda admin bo'lishi shart.
TELEGRAM_CHAT_ID=@mening_kanalim

# ---------- 3) YOUTUBE (Agent 3, ixtiyoriy) ----------
# 1 marta: python youtube_auth.py  -> youtube_token.json yaratiladi
YOUTUBE_ENABLED=true
YOUTUBE_CLIENT_SECRET=client_secret.json
YOUTUBE_TOKEN_FILE=youtube_token.json
# public | unlisted | private
YOUTUBE_PRIVACY=public

# true  -> video Telegramga tugmalar bilan boradi, siz tasdiqlagach YouTube'ga chiqadi
# false -> darhol YouTube'ga yuklaydi
APPROVAL_MODE=true

# ---------- 4) KONTENT ----------
NICHE=mind-blowing history and science facts
LANG=en
VOICE=en-US-AndrewMultilingualNeural
SCENES=6
IMAGE_STYLE=cinematic photoreal, dramatic lighting, rich colors, 35mm film grain, highly detailed
MUSIC_DIR=assets/music
MUSIC_VOLUME=0.10
